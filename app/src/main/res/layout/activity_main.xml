<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <dev.terraformist.upthere.UpThereView
        android:id="@+id/screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/remind"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="@string/remind"
            android:textColor="#000000"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- An invisible tap area over the drawn title. Placed in code to sit exactly on it. -->
    <View
        android:id="@+id/title_tap"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_gravity="top|center_horizontal"
        android:clickable="true"
        android:contentDescription="@string/about_open"
        android:focusable="true" />

    <!-- About: a card over the dimmed screen. Tap outside it, OK, or Back to close. -->
    <FrameLayout
        android:id="@+id/about_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:contentDescription="@string/about_close"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/about_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/card_bg"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <dev.terraformist.upthere.DotTextView
                    android:id="@+id/about_headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:importantForAccessibility="yes" />

                <dev.terraformist.upthere.MiniPassView
                    android:layout_width="44dp"
                    android:layout_height="36dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <TextView
                android:id="@+id/about_line1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_line1"
                android:textColor="#F2F2F2"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/about_line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/about_line2"
                android:textColor="#F2F2F2"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/about_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.1"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/about_tips"
                android:textColor="#9A9A9A"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/about_signoff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="@string/about_signoff"
                    android:textColor="#9A9A9A"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/about_ok"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/button_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:minWidth="72dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/about_ok"
                    android:textColor="#000000"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
